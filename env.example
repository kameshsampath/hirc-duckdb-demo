# Snowflake Account Settings
# Get your account identifier: https://docs.snowflake.com/en/user-guide/admin-account-identifier
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_ACCOUNT_URL=https://your_account.snowflakecomputing.com
SNOWFLAKE_USER=your_username

# PAT (Programmatic Access Token) - Used for authentication
# Generate this using: snow-utils pat:create
# Docs: https://docs.snowflake.com/en/user-guide/programmatic-access-tokens
SNOWFLAKE_PASSWORD=your_pat_token

# Demo Database Configuration
# This is the database containing your Snowflake-managed Iceberg tables
DEMO_DATABASE=YOUR_ICEBERG_DATABASE

# External Volume Name
# Required for Iceberg table storage
# Docs: https://docs.snowflake.com/en/sql-reference/sql/create-external-volume
EXTERNAL_VOLUME_NAME=your_external_volume

# Service Account Configuration for Horizon Catalog Access
# Note: Role names with hyphens (-) are NOT supported for Horizon Catalog
# Docs: https://docs.snowflake.com/en/user-guide/tables-iceberg-query-using-external-query-engine-snowflake-horizon
SA_USER=your_service_account_user
SA_ROLE=your_service_account_role
SA_ADMIN_ROLE=your_admin_role

# PAT Objects Database
# Database where PAT-related objects are stored
PAT_OBJECTS_DB=your_pat_objects_database
